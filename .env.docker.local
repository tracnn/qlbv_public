# Bien moi truong danh RIENG cho stack Docker (Ke hoach 1 - Laravel 5.5 / PHP 7.4).
# File nay duoc cac service app/queue/scheduler nap qua `env_file: env.docker` trong
# docker-compose.yml - KHONG dung `.env` cua may that (file do tro DB_HOST=localhost,
# tuc la ben trong container se tro vao chinh container do, sai hoan toan).
#
# Truoc khi chay: dien <...> ben duoi bang thong tin that cua MySQL dang chay tren
# may host (thuong la root, mat khau rong o moi truong dev hien tai).

# Application
APP_NAME=QLBV
APP_ENV=local
APP_KEY=base64:EHFF9R8DNQr4WBP+Ht7peer+AP/X8aY5IS7v8uXwNf8=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Database ung dung: MySQL "qlbv" dang chay TREN CHINH MAY HOST (khong phai bang
# sao, hien la CSDL rong - 31 bang so voi 146 migration, khong co du lieu; tinh trang
# nay da duoc chap nhan, KHONG tao ban sao / KHONG nap du lieu).
# Tu trong container, "localhost" tro vao chinh container - PHAI dung
# host.docker.internal de tro ra may host chay XAMPP/MySQL that.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=qlbv
DB_USERNAME=root
DB_PASSWORD=

# Oracle (HIS/LIS/ACS/SDA/EMR - tai khoan CHI DOC): KHONG dat bien o day.
# config/database.php khai bao cung (hardcode) host/username/password cho tung
# connection ('oracle', 'HISPro', 'LIS_RS', 'ACS_RS', 'SDA_RS', 'EMR_RS') va KHONG
# doc bat ky bien env() nao cho Oracle. Dat ORACLE_* o day se khong co tac dung va
# de gay hieu nham nen co tinh bo qua (xem task-12-report.md).

# Redis - instance RIENG cua stack Docker (service `redis` trong docker-compose.yml),
# khong lien quan Redis/queue that tren host (neu co).
# Task 14 brief goc de nghi them REDIS_DB=15 / REDIS_QUEUE=docker-thu-nghiem de tranh
# dam vao hang doi that qua mot Redis DUNG CHUNG. Khong ap dung o day: Task 12 da chon
# kien truc khac - Redis nay la MOT CONTAINER RIENG BIET hoan toan, khong phai cung
# instance voi Redis/queue that ma nssm dang dung tren host, nen khong co Redis nao de
# "dung chung" ma phai tach index/ten hang doi. config/database.php cung hardcode
# 'database' => 0 cho ket noi Redis (khong doc env REDIS_DB), nen dat bien nay se
# khong co tac dung. Xem task-14-report.md muc Buoc 9 de biet chi tiet doi chieu.
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Session dung Redis rieng noi tren. Queue driver dung ten dung Laravel 5.5
# la QUEUE_DRIVER (khong phai QUEUE_CONNECTION - ban cu ghi sai ten bien nay).
# Ten hang doi rieng ("qlbv_docker") duoc truyen qua --queue trong lenh queue:work
# o docker-compose.yml, khong sua duoc qua bien env vi config/queue.php hardcode
# 'queue' => 'default'.
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail - tat gui that trong moi truong Docker (khong co mailhog trong stack nay)
MAIL_DRIVER=log

# Broadcasting: Task 4 da go Pusher that su khoi luong dung (BroadcastServiceProvider
# van con dang ky trong config/app.php nhung khong con noi nao dung driver pusher).
# Dat log de tranh canh bao, khong can bien PUSHER_* nua.
BROADCAST_DRIVER=log

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
