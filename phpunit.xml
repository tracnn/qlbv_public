<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>

        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist processUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">./app</directory>
        </whitelist>
    </filter>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!-- CHOT AN TOAN - DUNG BAO GIO XOA HAI DONG NAY.

             .env cua du an tro DB_DATABASE=qlbv, la co so du lieu PHAT TRIEN THAT. Truoc khi
             co hai dong nay, bat ky test nao dung RefreshDatabase hay DatabaseMigrations deu
             goi migrate:fresh THANG VAO qlbv - tuc DROP TOAN BO BANG. Chuyen do da xay ra
             that ngay 2026-08-21: toan bo qlbv bi xoa sach, khong co binlog va khong co ban
             dump nao chua bang ctdt de lui ve.

             Ghi de o day tro bo test sang schema VUT DI qlbv_test. Mot trait nhu the gio
             chi xoa qlbv_test - dung lai duoc bang mot lenh migrate.

             KHONG tro sang sqlite: khoang 55 test trong tests/Unit/Import va
             tests/Unit/OrderCheck doc va GHI bang that (medicine_catalogs). Tren sqlite
             rong chung khong chay duoc, va mot bo test tat tieng thi khong bao ve duoc gi.

             tests/TestCase.php con mot lop chan thu hai, phong khi tep nay bi sua. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="qlbv_test"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <!-- Nhieu test co y kich duong loi (401 cong Dien Bien, thieu MACSKCB, sai PIN USB
             token) nen service ghi WARNING/ERROR. Khong chan thi chung do vao
             storage/logs/laravel-*.log dung dinh dang y het su co that, va nguoi doc log mat
             cong dieu tra mot loi khong ton tai - da xay ra that.
             Laravel 5.5 khong co driver log 'null', nen nang nguong len 'emergency'.
             Loi cua test van bao qua PHPUnit, khong mat thong tin gi. -->
        <env name="APP_LOG_LEVEL" value="emergency"/>
    </php>
</phpunit>
